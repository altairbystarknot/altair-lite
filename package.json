{
  "name": "altair-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Altair Lite: run a small tourism business from your own Claude. An open demo of the Altair idea with sample data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/mcp-smoke.mjs",
    "check": "tsc --noEmit && next build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
